{
  "name": "pandekode-hq",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "main": "electron/main.cjs",
  "author": "Pandekode HQ",
  "description": "Interactive 3D Virtual Workspace with AI Agents",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build:frontend": "npm run build -w frontend",
    "electron:start": "electron .",
    "electron:dev": "cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "desktop:dev": "concurrently -k -s first \"npm run dev\" \"wait-on http-get://localhost:5173 && npm run electron:dev\"",
    "build:exe": "npm run build:frontend && electron-builder --win",
    "build:exe:dir": "npm run build:frontend && electron-builder --win --dir"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/openai": "^1.2.14",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^4.19.2",
    "langchain": "^1.5.16",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "build": {
    "appId": "com.pandekode.hq",
    "productName": "Pandekode HQ",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/sqlite3/**"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "packages/frontend/dist/**/*",
      "packages/backend/src/**/*",
      "packages/backend/package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "npm-run-all": "^4.1.5",
    "wait-on": "^9.5.1"
  }
}
